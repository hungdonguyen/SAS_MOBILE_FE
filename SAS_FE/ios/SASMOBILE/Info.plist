<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>SAS_MOBILE</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
	  <!-- Do not change NSAllowsArbitraryLoads to true, or you will risk app rejection! -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Camera (face capture & biometric registration) -->
	<key>NSCameraUsageDescription</key>
	<string>SAS Mobile cần quyền truy cập Camera để chụp ảnh khuôn mặt phục vụ điểm danh sinh trắc học và đăng ký nhận diện khuôn mặt.</string>

	<!-- Photo Library (image picker) -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SAS Mobile cần quyền truy cập Thư viện Ảnh để chọn ảnh chân dung phục vụ đăng ký nhận diện khuôn mặt.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SAS Mobile cần quyền lưu ảnh vào Thư viện để lưu lại ảnh chụp khuôn mặt trong quá trình điểm danh.</string>

	<!-- Location (GPS Geofencing for check-in) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SAS Mobile cần quyền truy cập Vị trí để xác minh bạn đang ở trong khuôn viên trường trong quá trình điểm danh (GPS Geofencing).</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>SAS Mobile sử dụng vị trí GPS để xác thực khu vực địa lý khi điểm danh lớp học.</string>

	<!-- Microphone (required by iOS camera API) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>SAS Mobile cần quyền Microphone vì hệ thống camera iOS yêu cầu quyền này khi mở camera.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
